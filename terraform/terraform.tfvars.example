# Copy this file to terraform.tfvars and fill in the values
# DO NOT commit terraform.tfvars to version control!

aws_region     = "us-east-1"
project_name   = "much-to-do"
key_pair_name  = "much-to-do-deploy"  # Create via: aws ec2 create-key-pair --key-name much-to-do-deploy

# Application Secrets
mongo_uri            = "mongodb+srv://user:password@cluster.mongodb.net/much_todo_db?retryWrites=true&w=majority"
db_name              = "much_todo_db"
jwt_secret_key       = "your-super-secret-key-that-is-long-and-random-change-me"
jwt_expiration_hours = 72

# Instance sizing
ec2_instance_type = "t3.micro"
redis_node_type   = "cache.t3.micro"
